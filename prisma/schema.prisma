generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id       Int    @id @default(autoincrement())
  nome     String
  email    String @unique
  senha    String
  telefone String

  publicacao Publicacao[]
}

model Publicacao {
  id Int @id @default(autoincrement())
  titulo String
  descricao String
  imagem String?

  usuarioId Int

  usuario Usuario @relation(fields: [usuarioId], references: [id])

}